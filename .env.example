# Copy to .env. No credentials are necessary for the clearly labeled demo.
DEMO_MODE=auto
PORT=5000
FRONTEND_URL=http://localhost:5173
APP_TIMEZONE=Asia/Bangkok
DATABASE_URL=sqlite:///pagepulse.db
# Generate once: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Generate once: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Current version verified October 23, 2026. Review Meta's changelog before upgrades.
META_GRAPH_VERSION=v26.0
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:5173/api/facebook/callback
META_PERMISSIONS=pages_show_list,pages_read_engagement,read_insights
COOKIE_SECURE=false
RATELIMIT_STORAGE_URI=memory://
# PostgreSQL example (create database, then run migrations):
# DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/pagepulse
